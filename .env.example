# WhatsApp API (from Meta Developers)
WHATSAPP_TOKEN=your_permanent_token_here
WHATSAPP_PHONE_NUMBER_ID=926858947172521
VERIFY_TOKEN=my_secret_verify_token_change_this

# Graph API version
GRAPH_API_VERSION=v22.0

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini

# Database
DATABASE_PATH=data/chat_history.db

# Google Sheets — GOOGLE_SHEETS_ID (hoja "Reparaciones") ya NO se usa para
# buscar reparaciones, ver KELATOS_API_* abajo. GOOGLE_PRICES_SHEET_ID sigue
# activo (precios/equipos no se migraron).
GOOGLE_SHEETS_ID=your_google_sheet_id_here
# Google Sheets (prices — separate spreadsheet)
GOOGLE_PRICES_SHEET_ID=your_prices_sheet_id_here
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
SHEETS_CACHE_TTL=300

# Kelatos API (dashboard Postgres) — fuente real para buscar el estado de
# una reparación por resguardo/teléfono, en vez del Sheet "Reparaciones".
# KELATOS_API_TOKEN es el mismo Bearer interno que usa el propio dashboard.
KELATOS_API_BASE_URL=https://db.affirmatechnology.com/kelatos-api
KELATOS_API_TOKEN=your_kelatos_api_bearer_token_here

# Google Calendar
GOOGLE_CALENDAR_ID=soporte@kelatos.com
GOOGLE_CALENDAR_SUBJECT=soporte@kelatos.com

# Chatwoot
CHATWOOT_URL=https://chat.affirmatechnology.com
CHATWOOT_BOT_TOKEN=your_agent_bot_token_here
CHATWOOT_ACCOUNT_ID=2

# EspoCRM (ACTIVO)
ESPOCRM_URL=http://187.124.38.104:8080
ESPOCRM_API_KEY=dbbc0cbfcd4d93f47ead91baac3986a1
# Nombre interno de la entidad custom en EspoCRM donde se crean los registros.
ESPOCRM_ENTITY=CWTSBot
# Segundos a esperar desde el primer mensaje antes de volcar la conversacion a Espo (20 min = 1200).
ESPOCRM_LEAD_DELAY_SECONDS=1200
# Inactividad tras la cual un nuevo mensaje cuenta como conversacion nueva y crea otro lead (24 h = 86400).
ESPOCRM_NEW_LEAD_AFTER_SECONDS=86400

# Odoo CRM (DESCONECTADO - dejado por compatibilidad, ya no se usa)
# ODOO_URL=
# ODOO_DB=odoo
# ODOO_USER=admin
# ODOO_PASSWORD=admin
# ODOO_TEAM_ID=7

# Bot personality - customize this for your business!
SYSTEM_PROMPT=Eres el asistente virtual de Kelatos. Tu trabajo es ayudar a los clientes respondiendo sus preguntas de forma amable, clara y concisa. El primer saludo es siempre en español; a partir de ahí responde en el mismo idioma en que escriba el cliente (por defecto español si no está claro). Si no sabes algo, dilo honestamente. Si el cliente necesita hablar con una persona, dile que le vas a pasar con un agente. Mantén las respuestas cortas.
